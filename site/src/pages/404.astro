---
import '@fontsource-variable/open-sans'
import '../styles/site.css'
import Search from '../components/Search.astro'
---
<!doctype html>
<html lang="en" data-site="support-doc">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found - eMarketeer Support</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline src="/404-language.js"></script>
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
  </head>
  <body>
    <main class="not-found">
      <a class="site-title" data-language="en" href="/">
        <picture>
          <source srcset="/logo.svg" media="(prefers-color-scheme: dark)" />
          <img src="/logo-dark.svg" alt="eMarketeer" width="123" height="32" />
        </picture>
        <span>Support</span>
      </a>
      <a class="site-title" data-language="sv" href="/docs/docs_se">
        <picture>
          <source srcset="/logo.svg" media="(prefers-color-scheme: dark)" />
          <img src="/logo-dark.svg" alt="eMarketeer" width="123" height="32" />
        </picture>
        <span>Support</span>
      </a>
      <Search />
      <section data-language="en">
        <h1>Page not found</h1>
        <p><a href="/">Go to eMarketeer Support</a></p>
      </section>
      <section data-language="sv">
        <h1>Sidan hittades inte</h1>
        <p><a href="/docs/docs_se">Gå till eMarketeer Support</a></p>
      </section>
    </main>
  </body>
</html>
