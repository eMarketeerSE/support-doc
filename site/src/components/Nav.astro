---
import { some } from 'lodash-es'
import { isNavItemOpen, type NavItem } from '../lib/summary'

type Props = { items: NavItem[]; currentUrl: string; topLevel?: boolean }

const { items, currentUrl, topLevel = false } = Astro.props
const hasIcons = topLevel && some(items, 'icon')
---
<ul>
  {items.map((item) => {
    const link = (
      <a href={item.url} aria-current={item.url === currentUrl ? 'page' : undefined}>
        {hasIcons && <span class="nav-icon" set:html={item.icon ?? ''} />}
        {item.title}
      </a>
    )
    return (
      <li>
        {item.children.length > 0 ? (
          <details open={isNavItemOpen(item, currentUrl)}>
            <summary>{link}</summary>
            <Astro.self items={item.children} currentUrl={currentUrl} />
          </details>
        ) : (
          link
        )}
      </li>
    )
  })}
</ul>
